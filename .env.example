# Leave the Midtrans keys empty to run in demo mode.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# 32+ random characters
PROTECT_SECRET=

# Neon Postgres (orders only). Optional: without it, purchases live only in
# the buyer's signed cookie and library restore is switched off.
# Pooled URL for the app, direct URL for scripts/db-migrate.mjs.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Private Vercel Blob store for the source PDFs. Optional: without it,
# /api/read reads private/pdfs from disk.
BLOB_READ_WRITE_TOKEN=
